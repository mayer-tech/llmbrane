@hostname = http://localhost:8080


### GET models
GET {{hostname}}/openai/v1/models
###
GET {{hostname}}/anthropic/v1/models

### Test explicit provider/model
POST {{hostname}}/openai/v1/chat/completions
Content-Type: application/json

{
    "model": "gemini/gemini-flash-lite-latest",
    "messages": [
        {
            "role": "user",
            "content": "Sag mal Hallo."
        }
    ]
}

### Test Anthropic Messages API
POST {{hostname}}/anthropic/v1/messages
Content-Type: application/json

{
    "model": "gemini/gemini-flash-lite-latest",
    "max_tokens": 1024,
    "messages": [
        {
            "role": "user",
            "content": "Sag mal Hallo."
        }
    ]
}

### Test Reasoning Effort via OpenAI Inbound
POST {{hostname}}/openai/v1/chat/completions
Content-Type: application/json

{
    "model": "gpt-latest",
    "reasoning_effort": "high",
    "messages": [
        {
            "role": "user",
            "content": "Erkläre Quantenverschränkung in zwei Sätzen."
        }
    ]
}

### Test Extended Thinking via Anthropic Inbound
POST {{hostname}}/anthropic/v1/messages
Content-Type: application/json

{
    "model": "claude-sonnet",
    "max_tokens": 2048,
    "thinking": {
        "type": "enabled",
        "budget_tokens": 2048
    },
    "messages": [
        {
            "role": "user",
            "content": "Erkläre Quantenverschränkung in zwei Sätzen."
        }
    ]
}

